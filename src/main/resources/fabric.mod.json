{
	"schemaVersion": 1,
	"id": "masonryandmillwork",
	"version": "${version}",
	"name": "Masonry & Millwork",
	"description": "A small decorative mod adding more block variants to block sets",
	"authors": [
		"Withered_"
	],
	"license": "MIT",
	"icon": "assets/masonryandmillwork/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.withered.masonryandmillwork.MasonryAndMillwork"
		],
        "client": [
          "net.withered.masonryandmillwork.MasonryAndMillworkClient"
        ],
		"fabric-datagen": [
			"net.withered.masonryandmillwork.MasonryAndMillworkDataGenerator"
		],
        "jei_mod_plugin": [
          "net.withered.masonryandmillwork.compat.jei.MillingJEIPlugin"
        ]
	},
	"mixins": [
		"masonryandmillwork.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}