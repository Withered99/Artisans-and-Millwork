{
	"schemaVersion": 1,
	"id": "artisansandmillwork",
	"version": "${version}",
	"name": "Artisans & Millwork",
	"description": "A small decorative mod adding more block variants to block sets",
	"authors": [
		"Withered_"
	],
	"license": "MIT",
	"icon": "assets/artisansandmillwork/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.withered.artisansandmillwork.ArtisansAndMillwork"
		],
        "client": [
          "net.withered.artisansandmillwork.ArtisansAndMillworkClient"
        ],
		"fabric-datagen": [
			"net.withered.artisansandmillwork.ArtisansAndMillworkDataGenerator"
		],
        "jei_mod_plugin": [
          "net.withered.artisansandmillwork.compat.jei.MillingJEIPlugin"
        ]
	},
	"mixins": [
		"artisansandmillwork.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}